// FERCOPOR IA — Worker «ia» (Cloudflare Workers ligado ao GitHub Isabellylima/ia). Endereço previsto: ia.fercopor.app
{
  "name": "ia",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  // Estilo, logótipo e ícones; tudo o resto passa pelo Worker (login obrigatório)
  "assets": { "directory": "public", "binding": "ASSETS" },
  // Mantém os segredos do painel (MICROSOFT_*, ADMIN_EMAILS, SESSION_SECRET) em cada publicação
  "keep_vars": true,
  "observability": { "enabled": true },
  // Utilizadores, níveis de acesso e registo de alterações (Padrão de Acessos). Criada na primeira publicação.
  "kv_namespaces": [ { "binding": "IA_KV" } ],
  // Base de dados operacional da IA: conversas, mensagens e registo de pedidos (tokens, custo, limites). Criada na primeira
  // publicação, como a KV; o esquema é criado pela app na primeira utilização (src/ia/bd.js).
  "d1_databases": [ { "binding": "IA_DB" } ]
  // Segredo obrigatório no painel: ANTHROPIC_API_KEY. Opcional: AI_GATEWAY_ANTHROPIC_URL (Cloudflare AI Gateway).
}
